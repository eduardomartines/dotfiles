# omp runtime state — regenerated by omp, never track
omp/.omp/cache/
omp/.omp/logs/
omp/.omp/natives/
omp/.omp/oauth/
omp/.omp/puppeteer/
omp/.omp/run/
omp/.omp/marketplaces.json
omp/.omp/plugins/cache/
omp/.omp/plugins/node_modules/
omp/.omp/plugins/installed_plugins.json
omp/.omp/plugins/omp-plugins.lock.json
omp/.omp/agent/*.db
omp/.omp/agent/*.db-shm
omp/.omp/agent/*.db-wal
omp/.omp/agent/.env
omp/.omp/agent/blobs/
omp/.omp/agent/cache/
omp/.omp/agent/extensions/
omp/.omp/agent/last-changelog-version

# fish universal vars — machine state (tide cache, timestamps)
fish/.config/fish/fish_variables

# tern runtime
tern/.config/tern/account.lock
tern/.config/tern/plugins/

# never commit identities or secrets
git/.gitconfig.local
ssh/.ssh/config.local
ssh/.ssh/allowed_signers
ssh/.ssh/*.pub
ssh/.ssh/id_*
